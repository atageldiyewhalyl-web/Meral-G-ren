# Public base URL of the site (used for canonical/OG URLs and sitemap).
NEXT_PUBLIC_SITE_URL=https://kanzlei-goeren.de

# Shared secret for the meral-anfrage and meral-klick functions in nüll's
# Supabase project (srnynewvauzymnljqskj). Enquiries are stored in
# meral_anfragen and mailed from there; clicks go to meral_klicks.
# The site holds no database or mail keys. Same value as the Supabase secret
# MERAL_INQUIRY_SECRET.
MERAL_INQUIRY_SECRET=

# Optional: override the functions base URL (e.g. a local `supabase functions serve`).
# SUPABASE_FUNCTIONS_URL=https://srnynewvauzymnljqskj.supabase.co/functions/v1
